# DevGuard AI — environment configuration
# Copy to .env and fill in values. Never commit a real .env.

# --- Database -------------------------------------------------------------
# Async DSN used by the FastAPI app and Alembic.
DATABASE_URL=postgresql+asyncpg://devguard:devguard@localhost:5432/devguard

# Credentials consumed by docker-compose to provision the Postgres container.
POSTGRES_USER=devguard
POSTGRES_PASSWORD=devguard
POSTGRES_DB=devguard

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Per-request timeout (seconds) and retry budget for the Gemini call.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# --- Application ----------------------------------------------------------
LOG_LEVEL=INFO
# Pretty console logs in dev; set to "json" in production.
LOG_FORMAT=console
# Diffs larger than this (bytes) are truncated before analysis.
MAX_DIFF_BYTES=200000
# Comma-separated CORS origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ------------------------------------------------------
# Base URL the React app uses to reach the API. Place in frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8000/api/v1
